# Superior Ice Adventures - URL rewrites + live subdomain
RewriteEngine On

# Production: force HTTPS on the Webstar subdomain
RewriteCond %{HTTP_HOST} ^superioriceadventures\.webstarbusinessservices\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://superioriceadventures.webstarbusinessservices.com%{REQUEST_URI} [L,R=301]

# Clean article URLs: /articles/slug/ -> article.php?slug=slug
RewriteRule ^articles/([a-z0-9-]+)/?$ articles/article.php?slug=$1 [L,QSA]
